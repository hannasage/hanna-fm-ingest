# Copy to .env.local for local work. Never commit real values.
# Read from the environment by the import-export, poll, resolve-items and set-state commands.
# Local values come from `supabase status -o env`. Production values live in the host's secret store.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Read by the poll command. The refresh token comes from `npm run spotify-login`, which reads the client id and
# secret from the environment only. Production values live in the secrets of the `production` environment.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Optional, for tests only. Leave unset to use Spotify. Only accounts.spotify.com and api.spotify.com over https are allowed, plus localhost or 127.0.0.1 (http works there).
SPOTIFY_ACCOUNTS_BASE=
SPOTIFY_API_BASE=
# Optional, for `spotify-login`. The port of the redirect address, 1024 to 65535. Leave unset for 8765. The redirect
# URI registered in the Spotify app must name the same port: http://127.0.0.1:<port>/callback.
SPOTIFY_LOGIN_PORT=

# Used by `npm run resolve-items`. Required, no default. MusicBrainz asks for a User-Agent that says who
# calls and how to reach them: AppName/1.0 ( contact ). Put your own contact detail here, never in the repository.
MB_USER_AGENT=
# Tests only. https unless the host is localhost or 127.0.0.1. Leave empty for the real MusicBrainz.
MB_API_BASE=

# Used only by `npm run schema:sync`: the path of a sibling clone of the hanna-fm site repository.
HANNA_FM_PATH=
